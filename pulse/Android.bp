cc_library_shared {
    name: "libasound_module_pcm_pulse",

    arch: {
        arm: {
            instruction_set: "arm",
        },
    },
    proprietary: true,
    relative_install_path: "hw",

    include_dirs: [
        "external/alsa-lib/include",
        "external/pulseaudio/src/",
    ],

    cflags: [
        "-fPIC",
        "-DPIC",
        "-Wno-error",
    ],

    ldflags: ["-Wl,--no-fatal-warnings"],

    srcs: [
        "pcm_pulse.c",
        "pulse.c",
    ],

    shared_libs: [
        "libpulse",
        "libasound",
    ],

}

